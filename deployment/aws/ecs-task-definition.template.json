{
  "family": "esm2-localization-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "4096",
  "memory": "16384",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/esm2-localization-task-role",
  "containerDefinitions": [
    {
      "name": "esm2-localization-api",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/esm2-localization:bootstrap",
      "essential": true,
      "portMappings": [{"containerPort": 8000, "protocol": "tcp"}],
      "environment": [
        {"name": "MODEL_DEVICE", "value": "cpu"},
        {"name": "MODEL_CHECKPOINT", "value": "/app/model/best_checkpoint.pt"},
        {"name": "MODEL_S3_URI", "value": "s3://<PRIVATE_MODEL_BUCKET>/best_checkpoint.pt"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/esm2-localization-api",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "api"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)\" || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 120
      }
    }
  ]
}
