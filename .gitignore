.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Local presentation materials; do not publish to GitHub.
presentations/
.codex_presentation_build/

# Personal learning and exploratory notebooks.
notebooks_for_me/

# Keep downloaded data and trained artifacts out of Git.
data/raw/*
data/processed/*
!data/raw/README.md
!data/processed/README.md
results/models/*
!results/models/README.md
results/embeddings/*
!results/embeddings/README.md

# Fine-tuning checkpoints are large and remain local or in Google Drive.
# Lightweight configurations, histories, metrics, and predictions are tracked.
results/finetune/**/*.pt

# Query-level BLAST alignments are reproducible generated data; track summary only.
results/homology_audit/cross_split_blast_hits.csv
results/v2_external_validation/homology_hits.csv
results/v2_long_proteins/homology_hits.csv

# Per-protein outputs retain source identifiers/labels; publish aggregates only.
results/finetune/**/best_validation_predictions.csv
results/finetune/**/test_predictions.csv
results/metrics/classical_baselines/predictions.csv
results/metrics/v2_model_scaling/**/validation_predictions.csv
results/metrics/v2_model_scaling/**/test_predictions.csv
results/v2_external_validation/**/external_predictions.csv
results/v2_long_proteins/**/protein_predictions_overlap_*.csv
results/v2_long_proteins/**/window_predictions_overlap_*.csv
